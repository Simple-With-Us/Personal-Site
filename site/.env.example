# Local dev overrides — NO REAL VALUES.  Copy to .env for `npm run dev`.
# App-level settings live in Infisical (see INFISICAL.md at the repo root);
# these entries only matter when the Infisical bootstrap identity below is
# absent (degraded mode: everything falls back to process.env).

# --- Infisical bootstrap (the ONLY env vars that live outside Infisical) ---
# INFISICAL_CLIENT_ID=
# INFISICAL_CLIENT_SECRET=
# The app always reads Infisical prod.  An INFISICAL_ENV override with any other value is refused (warns and is ignored).

# --- The rest is read from Infisical when the bootstrap identity is set ---
# DATABASE_URL=
# GROK_AUTH_ISSUER=
# GROK_AUTH_CLIENT_ID=
# GROK_AUTH_CLIENT_SECRET=
# BETTER_AUTH_URL=
# BETTER_AUTH_SECRET=
# VITE_AUTH_ENABLED=true
# EMAIL_PASSWORD_ENABLED=
# DD_API_KEY=
# DD_SITE=
# DD_APPLICATION_ID=
# DD_CLIENT_TOKEN=
# DD_SERVICE=
# DD_ENV=
# DD_VERSION=
# DD_AGENT_HOST=
# DD_TRACE_AGENT_PORT=
# DD_TRACE_SAMPLE_RATE=
# DD_FAIL_CLOSED=
