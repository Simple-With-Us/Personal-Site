{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "git": {"deploymentEnabled": {"**": false, "main": true}},
  "framework": null,
  "buildCommand": "npm run build",
  "installCommand": "npm ci",
  "cleanUrls": true,
  "trailingSlash": false,
  "ignoreCommand": "bash vercel-ignore-hourly.sh",
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*)\\.(ico|png|svg|jpg|jpeg|webp|woff2|webmanifest)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, stale-while-revalidate=604800"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' 'unsafe-inline' https://*.datadoghq.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com data:; img-src 'self' data: https:; connect-src 'self' https://auth.grok.me https://*.logs.datadoghq.com https://browser-intake-datadoghq.com; frame-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self' https://auth.grok.me; frame-ancestors 'none'"
        }
      ]
    }
  ]
}
